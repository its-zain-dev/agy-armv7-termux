#!/bin/sh
# Early initramfs bootstrap for agy-armv7-termux (rdinit=/init-agy).
# Must remain strict POSIX sh compatible with BusyBox ash.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Alpine initramfs-virt ships busybox without applet symlinks; install them first!
if [ -x /bin/busybox ]; then
  BB=/bin/busybox
elif [ -x /usr/bin/busybox ]; then
  BB=/usr/bin/busybox
else
  echo "init-agy FATAL: busybox not found"
  exit 1
fi

"$BB" mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /sysroot /.modloop /lib/modules
"$BB" --install -s

# Ensure /dev/null and /dev/console exist before any redirections or devtmpfs mount
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1

log() {
  echo "[init-agy] $*" >/dev/console 2>&1 || echo "[init-agy] $*"
}

fail() {
  log "FATAL: $*"
  log "Block devices: $(ls -la /dev/vd* 2>&1 || true)"
  log "Partitions: $(cat /proc/partitions 2>&1 || true)"
  log "Filesystems: $(cat /proc/filesystems 2>&1 || true)"
  sync
  sleep 2
  poweroff -f 2>/dev/null || exit 1
}

log "starting early boot..."

mount -t sysfs -o noexec,nosuid,nodev sysfs /sys || fail "failed to mount /sys"
mount -t devtmpfs -o exec,nosuid,mode=0755 devtmpfs /dev || fail "failed to mount devtmpfs"
mount -t proc -o noexec,nosuid,nodev proc /proc || fail "failed to mount /proc"

log "loading virtio and squashfs modules..."
modprobe -a virtio_blk virtio_mmio squashfs loop 2>/dev/null || true

# Poll up to 30 seconds for /dev/vda (rootfs) and /dev/vdb (modloop)
i=0
while [ ! -b /dev/vda ] || [ ! -b /dev/vdb ]; do
  mdev -s 2>/dev/null || true
  i=$((i + 1))
  if [ "$i" -ge 60 ]; then
    fail "timed out waiting for /dev/vda and /dev/vdb"
  fi
  sleep 0.5
done

log "mounting modloop (/dev/vdb) to load ext4..."
mount -t squashfs -o ro /dev/vdb /.modloop || fail "failed to mount /dev/vdb modloop"

moddir=""
for cand in /.modloop/modules /.modloop/usr/lib/modules /.modloop/lib/modules; do
  if [ -d "$cand" ]; then
    moddir="$cand"
    break
  fi
done
[ -n "$moddir" ] || fail "could not locate modules directory in /.modloop"

mount -o bind "$moddir" /lib/modules || fail "failed to bind-mount $moddir to /lib/modules"

modprobe ext4 || fail "modprobe ext4 failed"

umount /lib/modules 2>/dev/null || true
umount /.modloop 2>/dev/null || true

log "mounting ext4 rootfs (/dev/vda)..."
mount -t ext4 -o rw,noatime /dev/vda /sysroot || fail "failed to mount /dev/vda on /sysroot"

# Hand live /dev into real rootfs so static device nodes are not required
mkdir -p /sysroot/dev
mount -o move /dev /sysroot/dev || fail "failed to move /dev to /sysroot/dev"

umount /proc 2>/dev/null || true
umount /sys 2>/dev/null || true

INIT=""
for cand in /sbin/agy-init /usr/sbin/agy-init; do
  if [ -x "/sysroot$cand" ]; then
    INIT="$cand"
    break
  fi
done
[ -n "$INIT" ] || fail "agy-init not found in /sysroot"

exec switch_root /sysroot "$INIT"
fail "switch_root failed"
