#!/bin/bash
# Safe base64-framed argument & environment dispatcher inside the Alpine VM.
# Every value uses the trailing-sentinel-'x' base64 format so empty strings,
# embedded/trailing newlines, quotes, flags, and UTF-8 pass verbatim.

set -euo pipefail

if [[ -f /run/agy-vm.env ]]; then
  # shellcheck disable=SC1091
  . /run/agy-vm.env
fi

b64_decode_sentinel() {
  local __var="$1"
  local __tok="$2"
  local __raw
  __raw="$(printf '%s' "$__tok" | base64 -d)"
  printf -v "$__var" '%s' "${__raw%x}"
}

target_bin="/usr/local/bin/agy"
cwd_b64=""
env_pairs=()
arg_tokens=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --binary)
      target_bin="$2"
      shift 2
      ;;
    --cwd)
      cwd_b64="$2"
      shift 2
      ;;
    --env)
      env_pairs+=("$2")
      shift 2
      ;;
    --)
      shift
      arg_tokens=("$@")
      break
      ;;
    *)
      echo "agy-exec: unexpected argument: $1" >&2
      exit 2
      ;;
  esac
done

export HOME="${AGY_HOME:-$HOME}"
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
export SHELL="/bin/bash"

for pair in "${env_pairs[@]}"; do
  k_b64="${pair%%:*}"
  v_b64="${pair#*:}"
  b64_decode_sentinel k "$k_b64"
  b64_decode_sentinel v "$v_b64"
  case "$k" in
    TERM|COLORTERM|LANG|LC_ALL|TZ|GEMINI_API_KEY|GOOGLE_API_KEY|HTTP_PROXY|HTTPS_PROXY|NO_PROXY|http_proxy|https_proxy|no_proxy|AGY_TEST_*)
      export "$k=$v"
      ;;
  esac
done

if [[ -n "$cwd_b64" ]]; then
  b64_decode_sentinel target_cwd "$cwd_b64"
  if [[ -n "$target_cwd" && -d "$target_cwd" ]]; then
    cd "$target_cwd"
  else
    cd "$HOME"
  fi
else
  cd "$HOME"
fi

decoded_args=()
for tok in "${arg_tokens[@]}"; do
  b64_decode_sentinel arg_val "$tok"
  decoded_args+=("$arg_val")
done

exec "$target_bin" "${decoded_args[@]}"
